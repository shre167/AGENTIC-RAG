# Replace the following values with your own credentials in a local `.env` file.
# Do NOT commit real API keys to version control. Keep `.env` in `.gitignore`.
GE_API_KEY=YOUR_GE_API_KEY_HERE
LLM_BASE_URL=https://your-llm-base-url.example.com/v1
LLM_MODEL=your-llm-model-name
EMBEDDING_MODEL=your-embedding-model-name

# Optional ingestion tuning (defaults shown)
# EMBEDDING_BATCH_SIZE=10
# EMBEDDING_MAX_RETRIES=5
# EMBEDDING_RETRY_BASE_DELAY=2.0

# Optional LLM-judged RAG metrics (uses the configured LLM endpoint)
# ENABLE_DEEPEVAL=false
# DEEPEVAL_METRICS=faithfulness,answer_relevancy
# DEEPEVAL_EVAL_MODES=hybrid
# DEEPEVAL_COMPARE_ALL_RETRIEVERS=false
